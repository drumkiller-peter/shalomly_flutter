# Build settings. Copy to .env (git-ignored), fill in, then run
#   dart run build_runner build -d
# Leave TENANT_KEY empty for a dynamic build (the Web app picks the church
# from its subdomain). CLIENT_ID and CLIENT_SECRET come from the backend's
# scripts.generate_api_client, which prints the secret only once.
TENANT_KEY=sbc
CHURCH_NAME=SBC Church
API_BASE_URL=http://127.0.0.1:8000/api/v1
CLIENT_ID=
CLIENT_SECRET=
